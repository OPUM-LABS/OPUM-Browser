                android:startX="28"
                android:startY="28"
                android:endX="80"
                android:endY="80">
                <item android:offset="0.0" android:color="#FF29F0FF" />
                <item android:offset="0.55" android:color="#FF1EA8FF" />
                <item android:offset="1.0" android:color="#FF196DFF" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Center dot (radius 4.8, centered at 54,54) -->
    <path android:pathData="M54,49.2 A4.8,4.8 0 1,1 54,58.8 A4.8,4.8 0 1,1 54,49.2 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="28"
                android:startY="28"
                android:endX="80"
                android:endY="80">
                <item android:offset="0.0" android:color="#FF29F0FF" />
                <item android:offset="1.0" android:color="#FF196DFF" />
