# Copy to keystore.properties (git-ignored) and fill in; then ./gradlew :app:bundleRelease (Google Play) or
# :app:assembleRelease (website / other stores) produce signed files. Keep the keystore and these passwords safe:
# an app can only be updated with the same key (on Google Play, Play App Signing keeps the app key; this is then
# your upload key).
storeFile=../keys/opum-release.jks
storePassword=
keyAlias=opum
keyPassword=
